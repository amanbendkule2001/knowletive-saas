# ── Core ─────────────────────────────────────────────
DATABASE_URL="postgresql://knowletive:knowletive@localhost:5544/knowletive?schema=public"
SESSION_SECRET="dev-only-change-me-to-a-64-char-random-string-before-production-0000"
APP_URL="http://localhost:3000"
NODE_ENV="development"

# ── AI (leave empty to run the deterministic demo provider) ──
# AI_PROVIDER="openai"        # openai | mock
# OPENAI_API_KEY=""
# OPENAI_BASE_URL="https://api.openai.com/v1"
# OPENAI_MODEL="gpt-4o-mini"

# ── Billing (provider-agnostic; manual works with no keys) ──
BILLING_PROVIDER="manual"     # manual | razorpay | stripe
BILLING_CURRENCY="INR"
# RAZORPAY_KEY_ID=""
# RAZORPAY_KEY_SECRET=""
# RAZORPAY_WEBHOOK_SECRET=""
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""

# ── Zero-Cost Persistent Storage (VPS local storage) ──────────
STORAGE_LOCAL_DIR=".data/uploads"

# ── Zero-Cost SMTP Mailer (Hostinger Business Mail / Postfix) ──
# SMTP_HOST="smtp.hostinger.com"
# SMTP_PORT="465"
# SMTP_USER="notifications@yourdomain.com"
# SMTP_PASS="your-strong-password"
# SMTP_FROM="Knowletive <notifications@yourdomain.com>"
