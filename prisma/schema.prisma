generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────── Platform & tenancy ───────────────────────────────

enum TenantStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CHURNED
}

enum TenantType {
  SCHOOL
  COLLEGE
  COACHING
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum RoleScope {
  PLATFORM
  TENANT
}

enum AuditActorType {
  PLATFORM
  TENANT
  SYSTEM
}

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
  IN_APP
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
  SKIPPED
}

enum FileKind {
  LOGO
  STUDENT_PHOTO
  DOCUMENT
  RECEIPT
}

enum PaymentLinkStatus {
  OPEN
  PAID
  EXPIRED
  CANCELED
}

model User {
  id              String       @id @default(cuid())
  email           String       @unique
  name            String
  passwordHash    String
  status          UserStatus   @default(ACTIVE)
  isPlatformOwner Boolean      @default(false)
  platformRoleId  String?
  avatarColor     String       @default("#4f46e5")
  emailVerifiedAt DateTime?
  twoFactorSecret String?
  twoFactorEnabled Boolean     @default(false)
  failedLoginAttempts Int      @default(0)
  lockedUntil     DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  platformRole       Role?               @relation("UserPlatformRole", fields: [platformRoleId], references: [id], onDelete: SetNull)
  memberships        Membership[]
  sessions           Session[]
  aiJobs             AiJob[]
  guardianProfiles   Guardian[]          @relation("GuardianUser")
  studentProfile     Student?            @relation("StudentUser")
  passwordResetTokens PasswordResetToken[]
  uploadedFiles      FileAsset[]         @relation("FileUploader")
  verifiedConsents   GuardianConsent[]   @relation("ConsentVerifiedBy")
  revokedConsents    GuardianConsent[]   @relation("ConsentRevokedBy")
  notifications      NotificationLog[]    @relation("NotificationRecipient")
  leadActivities     LeadActivity[]       @relation("LeadActivityActor")
  copilotThreads     CopilotThread[]

  @@index([status])
}

model Session {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime  @default(now())
  ip        String?
  userAgent String?
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  ip        String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model WebhookEvent {
  id          String    @id @default(cuid())
  provider    String
  eventId     String
  eventType   String?
  payload     Json?
  rawPayload  Json?
  tenantId    String?   // nullable for pre-routing events
  branchId    String?   // nullable
  status      String    @default("PENDING") // PENDING, PROCESSED, FAILED, DUPLICATE, IGNORED
  processedAt DateTime?
  error       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([provider, eventId])
  @@index([createdAt])
  @@index([tenantId])
  @@index([status])
  @@index([provider, createdAt])
}

model Tenant {
  id           String       @id @default(cuid())
  name         String
  slug         String       @unique
  type         TenantType   @default(SCHOOL)
  status       TenantStatus @default(TRIAL)
  email        String
  phone        String?
  website      String?
  address      String?
  city         String?
  state        String?
  country      String       @default("India")
  timezone     String       @default("Asia/Kolkata")
  currency     String       @default("INR")
  logoInitials String
  accentColor  String       @default("#4f46e5")
  notes        String?
  settings     Json?
  trialEndsAt  DateTime?
  approvedAt   DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  memberships    Membership[]
  roles          Role[]
  students       Student[]
  guardians      Guardian[]
  classes        ClassLevel[]
  sections       Section[]
  subjects       Subject[]
  academicYears  AcademicYear[]
  attendance     Attendance[]
  feeInvoices    FeeInvoice[]
  feePayments    FeePayment[]
  announcements  Announcement[]
  subscription   TenantSubscription?
  invoices       Invoice[]
  payments       Payment[]
  usage          TenantUsage[]
  aiJobs         AiJob[]
  auditLogs      AuditLog[]
  notifications  NotificationLog[]
  fileAssets     FileAsset[]
  guardianConsents GuardianConsent[]
  guardianConsentEvents GuardianConsentEvent[]
  paymentLinks   FeePaymentLink[]
  leads          Lead[]
  leadActivities LeadActivity[]
  batches        Batch[]
  syllabusTracks       SyllabusTrack[]
  syllabusChapters     SyllabusChapter[]
  syllabusTopics       SyllabusTopic[]
  lessonPlans          LessonPlan[]
  topicProgresses      TopicProgress[]
  syllabusProgressEvents SyllabusProgressEvent[]
  gradeScales          GradeScale[]
  gradeBands           GradeBand[]
  examinations         Examination[]
  examSubjects         ExamSubject[]
  examEnrollments      ExamEnrollment[]
  examMarks            ExamMark[]
  examResults          ExamResult[]
  examResultSnapshots  ExamResultSnapshot[]
  examMarksRevisionEvents ExamMarksRevisionEvent[]
  paymentReceipts            PaymentReceipt[]
  paymentReceiptBalances    PaymentReceiptBalance[]
  paymentAllocations        PaymentAllocation[]
  paymentAllocationReversals PaymentAllocationReversal[]
  studentCreditAccounts      StudentCreditAccount[]
  creditTransferRequests     CreditTransferRequest[]
  creditTransferApprovalEvents CreditTransferApprovalEvent[]
  creditTransferJournals     CreditTransferJournal[]
  creditTransferSourceAllocations CreditTransferSourceAllocation[]
  creditTransferPostings     CreditTransferPosting[]
  copilotThreads             CopilotThread[]
  branches                   Branch[]
  branchLedgerEntries        BranchLedgerEntry[]
  branchPayouts              BranchPayout[]
  studentFeePlans            StudentFeePlan[]
  studentFeeInstallments     StudentFeeInstallment[]
  demoFeePlans               DemoFeePlan[]
  demoFeeInstallments        DemoFeeInstallment[]
  paymentProviderConfigs     PaymentProviderConfig[]
  demoPaymentSessions        DemoPaymentSession[]
  membershipBranches         MembershipBranch[]
  branchReconciliations      BranchReconciliationAudit[]
  paymentCollectorRoutes     PaymentCollectorRoute[]

  @@index([status])
  @@index([createdAt])
}

// ─────────────────────────────── Branch isolation ───────────────────────────────

enum BranchType {
  MAIN
  SUB_BRANCH
}

enum BranchVerificationStatus {
  PENDING_VERIFICATION
  VERIFIED
}

enum BranchAssignmentScopeMode {
  EXACT_BRANCH
  BRANCH_AND_DESCENDANTS
  TENANT_WIDE
}

model Branch {
  id                 String                   @id @default(cuid())
  tenantId           String
  parentBranchId     String?
  branchType         BranchType               @default(MAIN)
  name               String
  code               String
  collectorCode      String?
  verificationStatus BranchVerificationStatus @default(PENDING_VERIFICATION)
  bankAccountName    String?
  bankAccountNumber  String?
  bankIfsc           String?
  bankBankName       String?
  isActive           Boolean                  @default(true)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent          Branch?         @relation("BranchChildren", fields: [tenantId, parentBranchId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  children        Branch[]        @relation("BranchChildren")
  memberships     Membership[]
  memberAssignments MembershipBranch[]
  students        Student[]
  feeInvoices     FeeInvoice[]
  feePayments     FeePayment[]
  paymentReceipts PaymentReceipt[]
  paymentAllocations PaymentAllocation[]
  paymentLinks    FeePaymentLink[]
  ledgerEntries   BranchLedgerEntry[]
  payouts         BranchPayout[]
  studentFeePlans        StudentFeePlan[]
  studentFeeInstallments StudentFeeInstallment[]
  demoFeePlans           DemoFeePlan[]
  demoFeeInstallments    DemoFeeInstallment[]
  paymentProviderConfigs PaymentProviderConfig[]
  demoPaymentSessions    DemoPaymentSession[]
  leads                  Lead[]
  creditTransfersSourced  CreditTransferJournal[]     @relation("CreditTransferSourceBranch")
  creditTransfersTargeted CreditTransferJournal[]    @relation("CreditTransferTargetBranch")
  fileAssets             FileAsset[]
  reconciledPreviousRecords BranchReconciliationAudit[] @relation("ReconciledPreviousBranch")
  reconciledNewRecords      BranchReconciliationAudit[] @relation("ReconciledNewBranch")
  collectorRoutes        PaymentCollectorRoute[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, branchType])
  @@index([collectorCode])
}

model Membership {
  id               String    @id @default(cuid())
  tenantId         String
  userId           String
  roleId           String
  employeeNo       String?
  designation      String?
  phone            String?
  isOwner          Boolean   @default(false)
  status           UserStatus @default(ACTIVE)
  extraPermissions String[]  @default([])
  denyPermissions  String[]  @default([])
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  branchId         String?

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role    @relation(fields: [roleId], references: [id])
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  branchAssignments         MembershipBranch[]
  branchAssignmentsCreated  MembershipBranch[]          @relation("BranchAssignmentsMade")
  reconciliationsPerformed  BranchReconciliationAudit[]
  assignedLeads Lead[] @relation("LeadAssignedStaff")
  assignedBatches BatchTeacher[]
  assignedSyllabuses   SyllabusTeacher[]
  lessonPlans          LessonPlan[]
  taughtProgresses     TopicProgress[]
  examinationsCreated  Examination[] @relation("ExamCreator")
  examMarksEntered     ExamMark[] @relation("MarkEnteredBy")
  examMarksVerified    ExamMark[] @relation("MarkVerifiedBy")
  examResultsPublished ExamResult[] @relation("ResultPublisher")

  @@unique([tenantId, id])
  @@unique([tenantId, userId])
  @@index([roleId])
  @@index([userId])
}

model MembershipBranch {
  id           String                    @id @default(cuid())
  tenantId     String
  membershipId String
  branchId     String
  scopeMode    BranchAssignmentScopeMode @default(EXACT_BRANCH)
  assignedById String?
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  membership Membership  @relation(fields: [tenantId, membershipId], references: [tenantId, id], onDelete: Cascade)
  branch     Branch      @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Cascade)
  assignedBy Membership? @relation("BranchAssignmentsMade", fields: [tenantId, assignedById], references: [tenantId, id], onDelete: SetNull)

  @@unique([tenantId, membershipId, branchId])
  @@index([tenantId, membershipId])
  @@index([tenantId, branchId])
}

model BranchReconciliationAudit {
  id                String   @id @default(cuid())
  tenantId          String
  recordType        String
  recordId          String
  previousBranchId  String?
  newBranchId       String?
  reason            String
  candidateEvidence String?
  reconciledById    String
  createdAt         DateTime @default(now())

  tenant         Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reconciledBy   Membership @relation(fields: [tenantId, reconciledById], references: [tenantId, id], onDelete: Restrict)
  previousBranch Branch?    @relation("ReconciledPreviousBranch", fields: [tenantId, previousBranchId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  newBranch      Branch?    @relation("ReconciledNewBranch", fields: [tenantId, newBranchId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([tenantId, recordType, recordId])
  @@index([tenantId, createdAt])
}

model Role {
  id          String    @id @default(cuid())
  scope       RoleScope @default(TENANT)
  tenantId    String?
  key         String
  name        String
  description String?
  isSystem    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant        Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions   RolePermission[]
  memberships   Membership[]
  platformUsers User[]           @relation("UserPlatformRole")

  @@unique([tenantId, key])
  @@index([scope])
}

model Permission {
  key         String   @id
  group       String
  label       String
  description String?
  scope       RoleScope @default(TENANT)

  roles RolePermission[]

  @@index([scope, group])
}

model RolePermission {
  roleId        String
  permissionKey String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([roleId, permissionKey])
  @@index([permissionKey])
}

// ─────────────────────────────── Plans & billing ───────────────────────────────

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  PAUSED
  CANCELED
  EXPIRED
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

model Plan {
  id               String   @id @default(cuid())
  key              String   @unique
  name             String
  description      String?
  priceMonthly     Int      @default(0) // minor units (paise)
  priceYearly      Int      @default(0)
  currency         String   @default("INR")
  maxStudents      Int      @default(250)
  maxStaff         Int      @default(25)
  maxStorageMb     Int      @default(2048)
  aiCreditsMonthly Int      @default(50)
  features         String[] @default([])
  trialDays        Int      @default(14)
  isPublic         Boolean  @default(true)
  isArchived       Boolean  @default(false)
  highlighted      Boolean  @default(false)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  subscriptions TenantSubscription[]
  invoices      Invoice[]
}

model TenantSubscription {
  id                 String             @id @default(cuid())
  tenantId           String             @unique
  planId             String
  status             SubscriptionStatus @default(TRIALING)
  billingCycle       BillingCycle       @default(MONTHLY)
  currentPeriodStart DateTime           @default(now())
  currentPeriodEnd   DateTime
  trialEndsAt        DateTime?
  cancelAtPeriodEnd  Boolean            @default(false)
  seats              Int                @default(1)
  provider           String             @default("manual")
  providerRef        String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   Plan    @relation(fields: [planId], references: [id])
  invoices Invoice[]

  @@index([status])
  @@index([planId])
}

model Invoice {
  id             String        @id @default(cuid())
  number         String        @unique
  tenantId       String
  subscriptionId String?
  planId         String?
  status         InvoiceStatus @default(OPEN)
  currency       String        @default("INR")
  subtotal       Int           @default(0)
  tax            Int           @default(0)
  total          Int           @default(0)
  periodStart    DateTime
  periodEnd      DateTime
  dueAt          DateTime
  paidAt         DateTime?
  notes          String?
  lines          Json?
  provider       String?
  providerRef    String?
  checkoutUrl    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription TenantSubscription? @relation(fields: [subscriptionId], references: [id])
  plan         Plan?               @relation(fields: [planId], references: [id])
  payments     Payment[]

  @@index([tenantId, status])
  @@index([createdAt])
}

model Payment {
  id          String        @id @default(cuid())
  tenantId    String
  invoiceId   String
  amount      Int
  currency    String        @default("INR")
  status      PaymentStatus @default(PENDING)
  provider    String        @default("manual")
  providerRef String?
  paidAt      DateTime?
  createdAt   DateTime      @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([provider, providerRef])
}

model TenantUsage {
  id             String   @id @default(cuid())
  tenantId       String
  periodStart    DateTime
  aiCreditsUsed  Int      @default(0)
  aiCreditsLimit Int      @default(0)
  storageBytes   BigInt   @default(0)
  updatedAt      DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, periodStart])
}

model FileAsset {
  id           String   @id @default(cuid())
  tenantId     String
  studentId    String?
  branchId     String?
  kind         FileKind @default(DOCUMENT)
  name         String
  mime         String
  size         Int
  storageKey   String   @unique
  provider     String   @default("local")
  uploadedById String?
  createdAt    DateTime @default(now())

  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student    Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)
  branch     Branch?  @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: SetNull)
  uploadedBy User?    @relation("FileUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  guardianConsents GuardianConsent[]

  @@index([tenantId, kind])
  @@index([tenantId, createdAt])
  @@index([studentId])
  @@index([tenantId, branchId])
}

model NotificationLog {
  id              String             @id @default(cuid())
  tenantId        String?
  recipientUserId String?
  channel         NotificationChannel
  template        String
  to              String
  subject         String?
  body            String
  status          NotificationStatus @default(QUEUED)
  provider        String?
  providerRef     String?
  attempts        Int                @default(0)
  error           String?
  meta            Json?
  sentAt          DateTime?
  isRead          Boolean            @default(false)
  readAt          DateTime?
  createdAt       DateTime           @default(now())

  tenant    Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recipient User?   @relation("NotificationRecipient", fields: [recipientUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([status])
  @@index([channel])
  @@index([recipientUserId, isRead])
}

model FeePaymentLink {
  id           String            @id @default(cuid())
  tenantId     String
  feeInvoiceId String
  token        String            @unique
  amount       Int
  currency     String            @default("INR")
  status       PaymentLinkStatus @default(OPEN)
  provider     String            @default("manual")
  providerRef  String?
  url          String?
  utrReference String?
  payerName    String?
  payerPhone   String?
  payerNotes   String?
  submittedAt  DateTime?
  expiresAt    DateTime
  paidAt       DateTime?
  createdAt    DateTime          @default(now())
  branchId     String?

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  feeInvoice FeeInvoice @relation(fields: [feeInvoiceId], references: [id], onDelete: Cascade)
  branch     Branch?    @relation(fields: [branchId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([tenantId, status])
  @@index([feeInvoiceId])
  @@index([provider, providerRef])
  @@index([tenantId, submittedAt])
  @@index([tenantId, branchId])
}

// ─────────────────────────────── Academics ───────────────────────────────

model AcademicYear {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leads  Lead[]
  batches Batch[]
  syllabusTracks SyllabusTrack[]
  examinations   Examination[]

  @@unique([tenantId, name])
}

model ClassLevel {
  id       String @id @default(cuid())
  tenantId String
  name     String
  order    Int    @default(0)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sections Section[]
  subjects Subject[]
  syllabusTracks SyllabusTrack[]
  examinations   Examination[]

  @@unique([tenantId, name])
}

model Section {
  id             String  @id @default(cuid())
  tenantId       String
  classId        String
  name           String
  capacity       Int     @default(40)
  classTeacherId String?

  tenant   Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  class    ClassLevel @relation(fields: [classId], references: [id], onDelete: Cascade)
  students Student[]
  syllabusTracks SyllabusTrack[]
  examinations   Examination[]

  @@unique([classId, name])
  @@index([tenantId])
}

model Subject {
  id        String  @id @default(cuid())
  tenantId  String
  classId   String?
  name      String
  code      String?
  teacherId String?

  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  class  ClassLevel? @relation(fields: [classId], references: [id], onDelete: SetNull)
  batches Batch[]
  syllabusTracks SyllabusTrack[]
  examSubjects   ExamSubject[]

  @@index([tenantId])
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  ALUMNI
}

model Student {
  id            String        @id @default(cuid())
  tenantId      String
  userId        String?       @unique
  admissionNo   String
  firstName     String
  lastName      String
  email         String?
  phone         String?
  dob           DateTime?
  gender        String?
  bloodGroup    String?
  address       String?
  status        StudentStatus @default(ACTIVE)
  classId       String?
  sectionId     String?
  admissionDate DateTime      @default(now())
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  branchId      String?

  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User?             @relation("StudentUser", fields: [userId], references: [id], onDelete: SetNull)
  section    Section?          @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  branch     Branch?           @relation(fields: [branchId], references: [id], onDelete: SetNull)
  guardians  StudentGuardian[]
  attendance Attendance[]
  feeInvoices FeeInvoice[]
  files      FileAsset[]
  lead       Lead?             @relation("LeadConvertedStudent")
  batchEnrollments      BatchStudent[]
  batchEnrollmentEvents BatchEnrollmentEvent[]
  examEnrollments       ExamEnrollment[]
  examMarks             ExamMark[]
  examResults           ExamResult[]
  examResultSnapshots   ExamResultSnapshot[]
  paymentReceipts       PaymentReceipt[]
  paymentAllocations    PaymentAllocation[]
  creditAccount         StudentCreditAccount?
  requestSourceTransfers CreditTransferRequest[] @relation("RequestSourceTransfers")
  requestTargetTransfers CreditTransferRequest[] @relation("RequestTargetTransfers")
  sourceTransfers       CreditTransferJournal[] @relation("SourceTransfers")
  targetTransfers       CreditTransferJournal[] @relation("TargetTransfers")
  sourceAllocations     CreditTransferSourceAllocation[] @relation("SourceAllocationStudents")
  targetAllocations     CreditTransferSourceAllocation[] @relation("TargetAllocationStudents")
  postingStudents       CreditTransferPosting[] @relation("PostingStudents")
  postingCounterparties CreditTransferPosting[] @relation("PostingCounterparties")
  sourceConsents        GuardianConsent[]       @relation("ConsentSourceStudent")
  destConsents          GuardianConsent[]       @relation("ConsentDestStudent")
  feePlans              StudentFeePlan[]
  feeInstallments       StudentFeeInstallment[]
  demoFeePlans          DemoFeePlan[]
  demoFeeInstallments   DemoFeeInstallment[]
  demoPaymentSessions   DemoPaymentSession[]

  @@unique([tenantId, id])
  @@unique([tenantId, admissionNo])
  @@index([tenantId, status])
  @@index([tenantId, classId])
  @@index([tenantId, sectionId])
  @@index([tenantId, branchId])
  @@index([tenantId, lastName, firstName])
  @@index([tenantId, firstName, lastName])
}

model Guardian {
  id         String   @id @default(cuid())
  tenantId   String
  name       String
  email      String?
  phone      String
  relation   String?
  occupation String?
  userId     String?
  createdAt  DateTime @default(now())

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user     User?             @relation("GuardianUser", fields: [userId], references: [id], onDelete: SetNull)
  students StudentGuardian[]
  consents GuardianConsent[]

  @@index([tenantId])
  @@index([tenantId, phone])
  @@index([userId])
}

model StudentGuardian {
  studentId  String
  guardianId String
  isPrimary  Boolean @default(false)

  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@id([studentId, guardianId])
  @@index([guardianId])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

model Attendance {
  id         String           @id @default(cuid())
  tenantId   String
  studentId  String
  date       DateTime         @db.Date
  status     AttendanceStatus @default(PRESENT)
  note       String?
  markedById String?
  createdAt  DateTime         @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, date])
  @@index([tenantId, date])
  @@index([tenantId, status])
}

enum FeeStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
  WAIVED
}

model FeeInvoice {
  id          String    @id @default(cuid())
  tenantId    String
  studentId   String
  number      String
  title       String
  amount      Int
  paidAmount  Int       @default(0)
  currency    String    @default("INR")
  status      FeeStatus @default(PENDING)
  dueDate     DateTime
  issuedAt    DateTime  @default(now())
  paidAt      DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  branchId    String?

  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student  Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  branch   Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  payments FeePayment[]
  paymentLinks FeePaymentLink[]
  paymentAllocations PaymentAllocation[]
  installments StudentFeeInstallment[]

  @@unique([tenantId, id])
  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@index([tenantId, dueDate])
  @@index([tenantId, branchId])
}

model FeePayment {
  id           String   @id @default(cuid())
  tenantId     String
  feeInvoiceId String
  amount       Int
  method       String   @default("CASH")
  reference    String?
  provider     String?
  providerRef  String?
  paidAt       DateTime @default(now())
  collectedById String?
  branchId      String?

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  feeInvoice FeeInvoice @relation(fields: [feeInvoiceId], references: [id], onDelete: Cascade)
  branch     Branch?    @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([tenantId, paidAt])
  @@index([provider, providerRef])
  @@index([tenantId, branchId])
}

// ─────────────────────────────── Branch Ledger & Payouts ───────────────────────────────

enum BranchLedgerEntryType {
  CREDIT_SETTLEMENT
  DEBIT_PAYOUT
  DEBIT_BOUNCE
  DEBIT_REFUND
  ADJUSTMENT_CREDIT
  ADJUSTMENT_DEBIT
}

enum BranchLedgerChannel {
  ONLINE_JODO
  OFFLINE_RECORD
}

enum BranchPayoutStatus {
  REQUESTED
  APPROVED
  PROCESSING
  PAID
  REJECTED
  FAILED
}

model BranchLedgerEntry {
  id            String                @id @default(cuid())
  tenantId      String
  branchId      String
  entryType     BranchLedgerEntryType
  channel       BranchLedgerChannel   @default(ONLINE_JODO)
  amount        Int                   // in paise (> 0)
  balanceAfter  Int                   // running online payable balance in paise
  currency      String                @default("INR")
  referenceType String                // WEBHOOK_EVENT, PAYMENT_RECEIPT, PAYOUT, MANUAL_ADJUSTMENT
  referenceId   String?
  utrReference  String?               // Bank UTR or gateway settlement ID
  description   String
  metadata      Json?
  postedAt      DateTime              @default(now())
  createdById   String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, branchId, postedAt])
  @@index([tenantId, referenceType, referenceId])
}

model BranchPayout {
  id                String             @id @default(cuid())
  tenantId          String
  branchId          String
  payoutNumber      String             // e.g. "PO-2026-0001"
  amount            Int                // In paise
  currency          String             @default("INR")
  status            BranchPayoutStatus @default(REQUESTED)
  bankAccountName   String?
  bankAccountNumber String?
  bankIfsc          String?
  bankBankName      String?
  utrReference      String?            // Bank UTR when disbursed
  requestedById     String
  requestedAt       DateTime           @default(now())
  processedById     String?
  processedAt       DateTime?
  rejectionReason   String?
  metadata          Json?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, payoutNumber])
  @@index([tenantId, branchId, status])
}

// ─────────────────────────────── Financial Ledger (Core Models) ───────────────────────────────

enum PaymentReceiptStatus {
  CAPTURED             // Funds successfully received in bank / cash drawer
  PARTIALLY_ALLOCATED  // Part of the receipt applied to one or more invoices
  FULLY_ALLOCATED      // Entire receipt applied to invoices
  OVERPAID_UNALLOCATED // Receipt contains unapplied customer credit balance
  REFUND_PENDING       // Refund requested or approved, funds reserved
  PARTIALLY_REFUNDED   // Partial refund disbursed to payer
  REFUNDED             // Entire receipt or unapplied balance refunded
  DISPUTED             // Chargeback or bank dispute active
  VOIDED               // Bounced cheque or cashier administrative void
}

model PaymentReceipt {
  id                 String   @id @default(cuid())
  tenantId           String
  studentId          String   // Primary student beneficiary at time of receipt
  receiptNumber      String   // Human-readable, e.g. "RCPT-2026-00142"
  amount             Int      // Gross money received in paise (IMMUTABLE EVENT)
  currency           String   @default("INR")
  method             String   // CASH, UPI, CARD, BANK_TRANSFER, CHEQUE
  reference          String?  // Bank UTR, Cheque No, or Gateway Payment Intent ID
  provider           String   @default("manual") // cashier, manual, razorpay, stripe
  merchantAccountKey String?  // External merchant/aggregator account key (MANDATORY for external providers)
  providerRef        String?  // External gateway transaction reference ID (Nullable: cashier cash has null)
  idempotencyKey     String?  // Client-supplied idempotency key (GAP-FIN-02)
  payloadHash        String?  // SHA-256 fingerprint of request parameters
  payerName          String?
  payerPhone         String?
  payerEmail         String?
  payerRelationship  String?  // FATHER, MOTHER, GUARDIAN, SPONSOR, SELF
  payerNotes         String?
  receivedAt         DateTime @default(now())
  createdById        String?
  createdAt          DateTime @default(now())
  branchId           String?

  // Foreign keys use RESTRICT to prevent financial history deletion
  // Composite tenant-isolated foreign keys enforce that student belongs strictly to receipt's tenant
  tenant      Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  student     Student                @relation(fields: [tenantId, studentId], references: [tenantId, id], onDelete: Restrict)
  branch          Branch?               @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  balance         PaymentReceiptBalance? // 1:1 mutable projection
  allocations     PaymentAllocation[]
  creditTransfers CreditTransferJournal[]
  creditSourceAllocations CreditTransferSourceAllocation[]
  creditPostings  CreditTransferPosting[]

  @@unique([tenantId, id])
  @@unique([tenantId, receiptNumber])
  @@index([tenantId, studentId])
  @@index([tenantId, receivedAt])
  @@index([tenantId, branchId])
}

model PaymentReceiptBalance {
  id                   String               @id @default(cuid())
  tenantId             String
  receiptId            String               @unique // 1:1 foreign key to immutable PaymentReceipt
  allocatedAmount      Int                  @default(0) // Active allocations on student bills
  transferredOutAmount Int                  @default(0) // Transferred to siblings via CreditTransferJournal DEBIT postings
  unappliedAmount      Int                  @default(0) // Available customer credit in paise
  reservedRefundAmount Int                  @default(0) // Funds reserved for pending refunds
  refundedAmount       Int                  @default(0) // Disbursed refunds in paise
  status               PaymentReceiptStatus @default(CAPTURED)
  version              Int                  @default(1) // Optimistic concurrency / update version counter
  lastRebalancedAt     DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  receipt PaymentReceipt @relation(fields: [tenantId, receiptId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, receiptId])
  @@index([tenantId, status])
  @@index([tenantId, unappliedAmount])
}

model PaymentAllocation {
  id               String   @id @default(cuid())
  tenantId         String
  receiptId        String   // Provenance: references original gross PaymentReceipt
  creditTransferId String?  // Optional: references CreditTransferJournal if funded via sibling transfer
  studentId        String   // Student whose bill is being settled
  feeInvoiceId     String   // Invoice settled
  branchId         String?  // Allocation branch (settled invoice branch at allocation time)
  amount           Int      // Amount applied to invoice in paise (IMMUTABLE EVENT)
  allocatedAt      DateTime @default(now())
  allocatedById    String?
  createdAt        DateTime @default(now())

  tenant         Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  receipt        PaymentReceipt              @relation(fields: [tenantId, receiptId], references: [tenantId, id], onDelete: Restrict)
  student        Student                     @relation(fields: [tenantId, studentId], references: [tenantId, id], onDelete: Restrict)
  creditTransfer CreditTransferJournal?      @relation(fields: [tenantId, creditTransferId], references: [tenantId, id], onDelete: Restrict)
  feeInvoice     FeeInvoice                  @relation(fields: [tenantId, feeInvoiceId], references: [tenantId, id], onDelete: Restrict)
  branch         Branch?                     @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  reversals      PaymentAllocationReversal[]

  @@unique([tenantId, id])
  @@index([tenantId, receiptId])
  @@index([tenantId, feeInvoiceId])
  @@index([tenantId, studentId])
  @@index([tenantId, creditTransferId])
  @@index([tenantId, branchId])
  @@index([feeInvoiceId, allocatedAt])
}

model PaymentAllocationReversal {
  id                   String   @id @default(cuid())
  tenantId             String
  originalAllocationId String   // References immutable original allocation
  amount               Int      // In paise (must be <= originalAllocation.amount)
  reason               String   // "Course drop", "Retroactive waiver", "Dispute"
  destination          String   @default("UNAPPLIED_CREDIT") // UNAPPLIED_CREDIT or REFUND_RESERVATION
  reversedAt           DateTime @default(now())
  reversedById         String?

  tenant             Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  originalAllocation PaymentAllocation @relation(fields: [tenantId, originalAllocationId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, originalAllocationId])
  @@index([originalAllocationId])
}

// ─────────────────────────────── Student Credit & Sibling Transfers ───────────────────────────────

enum CreditTransferStatus {
  PENDING_APPROVAL
  COMPLETED
  REJECTED
}

enum CreditTransferRequestStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  EXECUTED
  CANCELLED
}

enum TransferPostingType {
  DEBIT
  CREDIT
}

model StudentCreditAccount {
  id             String   @id @default(cuid())
  tenantId       String
  studentId      String   @unique
  balance        Int      @default(0) // Available customer credit in paise (non-negative)
  transferredIn  Int      @default(0) // Transferred from siblings via CreditTransferJournal CREDIT postings
  transferredOut Int      @default(0) // Transferred to siblings via CreditTransferJournal DEBIT postings
  transferredOnward Int   @default(0) // Transferred onward from received sibling credits
  allocatedIn    Int      @default(0) // Drawn towards student's invoices via PaymentAllocation
  status         String   @default("ACTIVE") // ACTIVE, FROZEN, CLOSED
  version        Int      @default(1) // Optimistic concurrency / update version counter
  lastActivityAt DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  student Student @relation(fields: [tenantId, studentId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, studentId])
  @@index([tenantId, status])
  @@index([tenantId, balance])
}

model CreditTransferRequest {
  id                   String                      @id @default(cuid())
  tenantId             String
  requestNumber        String                      // e.g. "CREQ-2026-00001"
  sourceStudentId      String                      // Sibling from whose credit transfer is requested
  targetStudentId      String                      // Sibling receiving the credit
  amount               Int                         // Transferred paise requested (> 0)
  reason               String                      // "Cross-sibling fee adjustment"
  status               CreditTransferRequestStatus @default(PENDING_APPROVAL)
  authorizedGuardianId String?                     // Verified guardian linking siblings
  guardianConsentRef   String?                     // Signed consent form asset ID / OTP ref
  guardianConsentId    String?                     // Verified GuardianConsent record link
  requestedById        String                      // Accountant user ID
  requestedAt          DateTime                    @default(now())
  reviewedById         String?                     // Principal / Institute Admin user ID
  reviewedAt           DateTime?
  rejectionReason      String?
  journalId            String?                     @unique // 1:1 link to executed journal
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt

  tenant         Tenant                        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  sourceStudent  Student                       @relation("RequestSourceTransfers", fields: [tenantId, sourceStudentId], references: [tenantId, id], onDelete: Restrict)
  targetStudent  Student                       @relation("RequestTargetTransfers", fields: [tenantId, targetStudentId], references: [tenantId, id], onDelete: Restrict)
  journal        CreditTransferJournal?        @relation("RequestJournal", fields: [tenantId, journalId], references: [tenantId, id], onDelete: Restrict)
  guardianConsent GuardianConsent?             @relation(fields: [tenantId, guardianConsentId], references: [tenantId, id], onDelete: Restrict)
  approvalEvents CreditTransferApprovalEvent[]

  @@unique([tenantId, id])
  @@unique([tenantId, requestNumber])
  @@unique([tenantId, journalId])
  @@index([tenantId, sourceStudentId])
  @@index([tenantId, targetStudentId])
  @@index([tenantId, status])
  @@index([tenantId, guardianConsentId])
  @@index([tenantId, createdAt])
}

model CreditTransferApprovalEvent {
  id        String   @id @default(cuid())
  tenantId  String
  requestId String
  action    String   // REQUESTED, APPROVED, REJECTED, CANCELLED, EXECUTED
  actorId   String   // User ID
  notes     String?
  createdAt DateTime @default(now())

  tenant  Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  request CreditTransferRequest @relation(fields: [tenantId, requestId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, requestId])
  @@index([tenantId, createdAt])
}

model CreditTransferJournal {
  id                   String               @id @default(cuid())
  tenantId             String
  transferNumber       String               // e.g. "TRNS-2026-00005"
  requestId            String?              @unique // Optional 1:1 link to request
  idempotencyKey       String?              // Client idempotency token for transfer
  sourceStudentId      String               // Source student debited
  targetStudentId      String               // Destination student credited
  sourceReceiptId      String?              // Optional: links to single source receipt (or null for multi-receipt)
  receiptProvenanceRef String?              // External bank UTR / Gateway Payment Intent ID
  amount               Int                  // Transferred paise (NO new PaymentReceipt created)
  reason               String               // "Cross-sibling fee adjustment"
  status               CreditTransferStatus @default(COMPLETED)
  authorizedGuardianId String?              // Verified guardian linking both siblings
  guardianConsentRef   String?              // Signed consent form asset ID or SMS OTP reference
  requestedById        String
  approvedById         String?
  sourceBranchId       String?
  targetBranchId       String?
  executedAt           DateTime?
  createdAt            DateTime             @default(now())

  tenant            Tenant                           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  request           CreditTransferRequest?           @relation("RequestJournal")
  sourceStudent     Student                          @relation("SourceTransfers", fields: [tenantId, sourceStudentId], references: [tenantId, id], onDelete: Restrict)
  targetStudent     Student                          @relation("TargetTransfers", fields: [tenantId, targetStudentId], references: [tenantId, id], onDelete: Restrict)
  sourceReceipt     PaymentReceipt?                  @relation(fields: [tenantId, sourceReceiptId], references: [tenantId, id], onDelete: Restrict)
  sourceBranch      Branch?                          @relation("CreditTransferSourceBranch", fields: [tenantId, sourceBranchId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  targetBranch      Branch?                          @relation("CreditTransferTargetBranch", fields: [tenantId, targetBranchId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  sourceAllocations CreditTransferSourceAllocation[]
  postings          CreditTransferPosting[]          // Balanced postings per transfer (DEBIT & CREDIT)
  allocations       PaymentAllocation[]

  @@unique([tenantId, id])
  @@unique([tenantId, transferNumber])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, sourceStudentId])
  @@index([tenantId, targetStudentId])
  @@index([tenantId, sourceReceiptId])
  @@index([tenantId, sourceBranchId])
  @@index([tenantId, targetBranchId])
  @@index([tenantId, createdAt])
}

model CreditTransferSourceAllocation {
  id              String   @id @default(cuid())
  tenantId        String
  journalId       String
  sourceReceiptId String
  sourceStudentId String
  targetStudentId String
  amount          Int      // Transferred paise from this specific receipt (> 0)
  createdAt       DateTime @default(now())

  tenant        Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  journal       CreditTransferJournal   @relation(fields: [tenantId, journalId], references: [tenantId, id], onDelete: Restrict)
  sourceReceipt PaymentReceipt          @relation(fields: [tenantId, sourceReceiptId], references: [tenantId, id], onDelete: Restrict)
  sourceStudent Student                 @relation("SourceAllocationStudents", fields: [tenantId, sourceStudentId], references: [tenantId, id], onDelete: Restrict)
  targetStudent Student                 @relation("TargetAllocationStudents", fields: [tenantId, targetStudentId], references: [tenantId, id], onDelete: Restrict)
  postings      CreditTransferPosting[]

  @@unique([tenantId, id])
  @@unique([tenantId, journalId, sourceReceiptId])
  @@index([tenantId, journalId])
  @@index([tenantId, sourceReceiptId])
  @@index([tenantId, sourceStudentId])
  @@index([tenantId, targetStudentId])
}

model CreditTransferPosting {
  id                    String              @id @default(cuid())
  tenantId              String
  journalId             String              // Transfer ID / Journal header FK
  sourceAllocationId    String?             // Optional link to specific source allocation line
  entryType             TransferPostingType // DEBIT or CREDIT
  studentId             String              // Student beneficiary of this posting (source for DEBIT, target for CREDIT)
  counterpartyStudentId String              // Opposite sibling student ID
  receiptId             String              // Provenance: links to original gross PaymentReceipt
  receiptProvenanceRef  String?             // Bank UTR or Gateway Payment Intent ID of original receipt
  amount                Int                 // Amount in paise
  createdAt             DateTime            @default(now())
  createdById           String?

  tenant           Tenant                          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  journal          CreditTransferJournal           @relation(fields: [tenantId, journalId], references: [tenantId, id], onDelete: Restrict)
  sourceAllocation CreditTransferSourceAllocation? @relation(fields: [tenantId, sourceAllocationId], references: [tenantId, id], onDelete: Restrict)
  student          Student                         @relation("PostingStudents", fields: [tenantId, studentId], references: [tenantId, id], onDelete: Restrict)
  counterpartyStudent Student                      @relation("PostingCounterparties", fields: [tenantId, counterpartyStudentId], references: [tenantId, id], onDelete: Restrict)
  receipt          PaymentReceipt                  @relation(fields: [tenantId, receiptId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, journalId])
  @@index([tenantId, sourceAllocationId])
  @@index([tenantId, studentId])
  @@index([tenantId, counterpartyStudentId])
  @@index([tenantId, receiptId])
}

// ─────────────────────────────── Guardian Consent ───────────────────────────────

enum ConsentScope {
  SIBLING_CREDIT_TRANSFER
  GENERAL_FINANCIAL
}

enum ConsentVerificationMethod {
  STAFF_VERIFIED_DOCUMENT
  DIGITAL_SIGNATURE
  OTP_CHALLENGE
}

enum ConsentStatus {
  PENDING
  VERIFIED
  REJECTED
  REVOKED
  EXPIRED
}

enum ConsentAction {
  CREATED
  VERIFIED
  REJECTED
  REVOKED
  EXPIRED
}

model GuardianConsent {
  id                    String                    @id @default(cuid())
  tenantId              String
  guardianId            String
  sourceStudentId       String
  destinationStudentId  String
  scope                 ConsentScope              @default(SIBLING_CREDIT_TRANSFER)
  fileAssetId           String?
  verificationMethod    ConsentVerificationMethod @default(STAFF_VERIFIED_DOCUMENT)
  status                ConsentStatus             @default(PENDING)
  verifiedById          String?
  verifiedAt            DateTime?
  rejectionReason       String?
  expiresAt             DateTime?
  isRevoked             Boolean                   @default(false)
  revokedAt             DateTime?
  revokedById           String?
  revocationReason      String?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  tenant                 Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  guardian               Guardian                @relation(fields: [guardianId], references: [id], onDelete: Restrict)
  sourceStudent          Student                 @relation("ConsentSourceStudent", fields: [tenantId, sourceStudentId], references: [tenantId, id], onDelete: Restrict)
  destinationStudent     Student                 @relation("ConsentDestStudent", fields: [tenantId, destinationStudentId], references: [tenantId, id], onDelete: Restrict)
  fileAsset              FileAsset?              @relation(fields: [fileAssetId], references: [id], onDelete: SetNull)
  verifiedBy             User?                   @relation("ConsentVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  revokedBy              User?                   @relation("ConsentRevokedBy", fields: [revokedById], references: [id], onDelete: SetNull)
  creditTransferRequests CreditTransferRequest[]
  events                 GuardianConsentEvent[]

  @@unique([tenantId, id])
  @@index([tenantId, guardianId])
  @@index([tenantId, sourceStudentId, destinationStudentId])
  @@index([tenantId, status])
  @@index([tenantId, scope])
  @@index([fileAssetId])
}

model GuardianConsentEvent {
  id        String        @id @default(cuid())
  tenantId  String
  consentId String
  action    ConsentAction
  actorId   String?
  actorName String?
  notes     String?
  createdAt DateTime      @default(now())

  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  consent GuardianConsent @relation(fields: [tenantId, consentId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, consentId])
  @@index([tenantId, action])
  @@index([tenantId, createdAt])
}

model Announcement {
  id          String   @id @default(cuid())
  tenantId    String
  title       String
  body        String
  audience    String   @default("ALL")
  pinned      Boolean  @default(false)
  authorId    String?
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, publishedAt])
}

// ─────────────────────────────── AI & audit ───────────────────────────────

enum AiJobStatus {
  SUCCEEDED
  FAILED
}

model AiJob {
  id         String      @id @default(cuid())
  tenantId   String
  userId     String?
  feature    String
  prompt     String
  output     String?
  credits    Int         @default(1)
  status     AiJobStatus @default(SUCCEEDED)
  provider   String      @default("mock")
  model      String?
  tokensIn   Int?
  tokensOut  Int?
  durationMs Int?
  error      String?
  createdAt  DateTime    @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([feature])
}

model AuditLog {
  id        String         @id @default(cuid())
  tenantId  String?
  actorId   String?
  actorType AuditActorType @default(SYSTEM)
  actorName String
  action    String
  entity    String?
  entityId  String?
  meta      Json?
  ip        String?
  createdAt DateTime       @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([createdAt])
  @@index([action])
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model RateLimitBucket {
  key       String   @id
  count     Int      @default(1)
  resetAt   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

// ─────────────────────────────── Stage 1: Leads ───────────────────────────────

enum LeadStatus {
  NEW
  CONTACTED
  FOLLOW_UP
  INTERESTED
  CONVERTED
  LOST
}

model Lead {
  id                 String     @id @default(cuid())
  tenantId           String
  branchId           String?
  studentName        String
  dob                DateTime?
  classInterested    String?
  academicYearId     String?
  guardianName       String
  guardianPhone      String
  guardianEmail      String?
  source             String     @default("WALK_IN")
  status             LeadStatus @default(NEW)
  assignedToId       String?
  nextFollowUp       DateTime?
  notes              String?
  convertedStudentId String?    @unique
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  tenant           Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch           Branch?       @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  academicYear     AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  assignedTo       Membership?   @relation("LeadAssignedStaff", fields: [assignedToId], references: [id], onDelete: SetNull)
  convertedStudent Student?      @relation("LeadConvertedStudent", fields: [convertedStudentId], references: [id], onDelete: SetNull)
  activities       LeadActivity[]

  @@index([tenantId, status])
  @@index([tenantId, branchId])
  @@index([tenantId, nextFollowUp])
  @@index([tenantId, guardianPhone])
}

model LeadActivity {
  id        String   @id @default(cuid())
  tenantId  String
  leadId    String
  actorId   String
  action    String
  notes     String
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  actor  User   @relation("LeadActivityActor", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
  @@index([tenantId])
}

// ─────────────────────────────── Batch Management (Stage 2) ───────────────────────────────

enum BatchStatus {
  DRAFT
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum BatchStudentStatus {
  ACTIVE
  DROPPED
  COMPLETED
  TRANSFERRED
}

enum BatchEventType {
  ENROLLED
  DROPPED
  RE_ENROLLED
  TRANSFERRED
  COMPLETED
}

model Batch {
  id             String       @id @default(cuid())
  tenantId       String
  academicYearId String
  subjectId      String?
  name           String
  code           String
  description    String?
  capacity       Int          @default(30)
  status         BatchStatus  @default(ACTIVE)
  startDate      DateTime?
  endDate        DateTime?
  schedule       String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  tenant       Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYear AcademicYear           @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  subject      Subject?               @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  teachers     BatchTeacher[]
  students     BatchStudent[]
  events       BatchEnrollmentEvent[]
  syllabusTracks SyllabusTrack[]
  examinations Examination[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@index([academicYearId])
  @@index([subjectId])
}

model BatchTeacher {
  id         String   @id @default(cuid())
  batchId    String
  teacherId  String
  isPrimary  Boolean  @default(false)
  assignedAt DateTime @default(now())

  batch   Batch      @relation(fields: [batchId], references: [id], onDelete: Cascade)
  teacher Membership @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([batchId, teacherId])
  @@index([teacherId])
}

model BatchStudent {
  id          String             @id @default(cuid())
  batchId     String
  studentId   String
  status      BatchStudentStatus @default(ACTIVE)
  enrolledAt  DateTime           @default(now())
  completedAt DateTime?
  droppedAt   DateTime?
  dropReason  String?

  batch   Batch   @relation(fields: [batchId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([batchId, studentId])
  @@index([batchId, status])
  @@index([studentId])
}

model BatchEnrollmentEvent {
  id            String         @id @default(cuid())
  batchId       String
  studentId     String
  actorId       String?
  actorName     String
  eventType     BatchEventType
  fromBatchId   String?
  toBatchId     String?
  effectiveDate DateTime       @default(now())
  reason        String?
  createdAt     DateTime       @default(now())

  batch   Batch   @relation(fields: [batchId], references: [id], onDelete: Restrict)
  student Student @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@index([batchId])
  @@index([studentId])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────
// STAGE 3: ENTERPRISE SYLLABUSTRACK & PROGRESS MANAGEMENT
// ─────────────────────────────────────────────────────────────

enum SyllabusTargetType {
  CLASS_SECTION
  BATCH
}

enum SyllabusStatus {
  DRAFT
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum TopicProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum LessonPlanStatus {
  DRAFT
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model SyllabusTrack {
  id             String             @id @default(cuid())
  tenantId       String
  academicYearId String
  subjectId      String
  targetType     SyllabusTargetType @default(CLASS_SECTION)
  classId        String?
  sectionId      String?
  batchId        String?
  name           String
  code           String
  description    String?
  status         SyllabusStatus     @default(DRAFT)
  startDate      DateTime?
  targetDate     DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  tenant       Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYear AcademicYear            @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  subject      Subject                 @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  class        ClassLevel?             @relation(fields: [classId], references: [id], onDelete: SetNull)
  section      Section?                @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  batch        Batch?                  @relation(fields: [batchId], references: [id], onDelete: SetNull)
  teachers     SyllabusTeacher[]
  chapters     SyllabusChapter[]
  topics       SyllabusTopic[]
  lessonPlans  LessonPlan[]
  progress     TopicProgress[]
  events       SyllabusProgressEvent[]
  examinations Examination[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@index([academicYearId])
  @@index([subjectId])
  @@index([classId])
  @@index([sectionId])
  @@index([batchId])
}

model SyllabusTeacher {
  id         String   @id @default(cuid())
  syllabusId String
  teacherId  String
  isPrimary  Boolean  @default(false)
  assignedAt DateTime @default(now())

  syllabus SyllabusTrack @relation(fields: [syllabusId], references: [id], onDelete: Cascade)
  teacher  Membership    @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([syllabusId, teacherId])
  @@index([teacherId])
}

model SyllabusChapter {
  id               String    @id @default(cuid())
  tenantId         String
  syllabusId       String
  title            String
  description      String?
  order            Int       @default(0)
  estimatedHours   Float     @default(0)
  plannedStartDate DateTime?
  plannedEndDate   DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  syllabus    SyllabusTrack   @relation(fields: [syllabusId], references: [id], onDelete: Cascade)
  topics      SyllabusTopic[]
  lessonPlans LessonPlan[]

  @@unique([syllabusId, order])
  @@index([tenantId])
}

model SyllabusTopic {
  id                 String              @id @default(cuid())
  tenantId           String
  syllabusId         String
  chapterId          String
  title              String
  description        String?
  order              Int                 @default(0)
  learningObjectives String?
  estimatedMinutes   Int                 @default(45)
  plannedDate        DateTime?
  status             TopicProgressStatus @default(NOT_STARTED)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  tenant      Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  syllabus    SyllabusTrack           @relation(fields: [syllabusId], references: [id], onDelete: Cascade)
  chapter     SyllabusChapter         @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  lessonPlans LessonPlan[]
  progress    TopicProgress?
  events      SyllabusProgressEvent[]

  @@unique([chapterId, order])
  @@index([syllabusId])
  @@index([tenantId])
}

model LessonPlan {
  id                    String           @id @default(cuid())
  tenantId              String
  syllabusId            String
  chapterId             String
  topicId               String
  teacherId             String
  title                 String
  objectives            String?
  methodology           String?
  materials             String?
  plannedDate           DateTime
  durationMinutes       Int              @default(45)
  completedDate         DateTime?
  actualDurationMinutes Int?
  status                LessonPlanStatus @default(PLANNED)
  remarks               String?
  homework              String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  syllabus SyllabusTrack   @relation(fields: [syllabusId], references: [id], onDelete: Cascade)
  chapter  SyllabusChapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  topic    SyllabusTopic   @relation(fields: [topicId], references: [id], onDelete: Cascade)
  teacher  Membership      @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([topicId])
  @@index([teacherId])
  @@index([tenantId, plannedDate])
}

model TopicProgress {
  id             String              @id @default(cuid())
  tenantId       String
  syllabusId     String
  topicId        String              @unique
  teacherId      String?
  status         TopicProgressStatus @default(NOT_STARTED)
  plannedDate    DateTime?
  completedDate  DateTime?
  completedHours Float               @default(0)
  notes          String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  syllabus SyllabusTrack @relation(fields: [syllabusId], references: [id], onDelete: Cascade)
  topic    SyllabusTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  teacher  Membership?   @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  @@unique([syllabusId, topicId])
  @@index([tenantId, status])
}

model SyllabusProgressEvent {
  id             String               @id @default(cuid())
  tenantId       String
  syllabusId     String
  topicId        String
  actorId        String?
  actorName      String
  previousStatus TopicProgressStatus?
  newStatus      TopicProgressStatus
  remarks        String?
  createdAt      DateTime             @default(now())

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  syllabus SyllabusTrack @relation(fields: [syllabusId], references: [id], onDelete: Cascade)
  topic    SyllabusTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([syllabusId, createdAt])
  @@index([topicId])
}

// ─────────────────────────────── Stage 4: Exam Management ───────────────────────────────

enum ExamType {
  UNIT_TEST
  MID_TERM
  FINAL
  MOCK_TEST
  PRACTICAL
  ASSIGNMENT
  CUSTOM
}

enum ExamTargetType {
  CLASS_SECTION
  BATCH
}

enum ExamStatus {
  DRAFT
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  EVALUATED
  PUBLISHED
  ARCHIVED
}

enum ExamEnrollmentStatus {
  REGISTERED
  ELIGIBLE
  ABSENT
  EXEMPTED
  WITHDRAWN
}

enum ExamEvaluationStatus {
  PENDING
  DRAFT
  SUBMITTED
  VERIFIED
}

enum ExamResultState {
  DRAFT
  COMPUTED
  VERIFIED
  PUBLISHED
}

enum ExamResultStatus {
  PASS
  FAIL
  WITHHELD
  EXPELLED
}

model GradeScale {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  code        String
  description String?
  isDefault   Boolean  @default(false)
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bands        GradeBand[]
  examinations Examination[]

  @@unique([tenantId, code])
  @@index([tenantId, isDefault])
}

model GradeBand {
  id            String   @id @default(cuid())
  tenantId      String
  scaleId       String
  letterGrade   String
  gradePoint    Float
  minPercentage Float
  maxPercentage Float
  isPassing     Boolean  @default(true)
  remarks       String?
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  scale  GradeScale @relation(fields: [scaleId], references: [id], onDelete: Cascade)

  @@unique([scaleId, letterGrade])
  @@index([scaleId, order])
}

model Examination {
  id              String         @id @default(cuid())
  tenantId        String
  academicYearId  String
  gradeScaleId    String
  syllabusTrackId String?
  targetType      ExamTargetType @default(CLASS_SECTION)
  classId         String?
  sectionId       String?
  batchId         String?
  title           String
  code            String
  examType        ExamType       @default(UNIT_TEST)
  status          ExamStatus     @default(DRAFT)
  term            String?
  instructions    String?
  startDate       DateTime
  endDate         DateTime
  isPublished     Boolean        @default(false)
  publishedAt     DateTime?
  createdById     String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  tenant        Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYear  AcademicYear              @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  gradeScale    GradeScale                @relation(fields: [gradeScaleId], references: [id], onDelete: Restrict)
  syllabusTrack SyllabusTrack?            @relation(fields: [syllabusTrackId], references: [id], onDelete: SetNull)
  class         ClassLevel?               @relation(fields: [classId], references: [id], onDelete: SetNull)
  section       Section?                  @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  batch         Batch?                    @relation(fields: [batchId], references: [id], onDelete: SetNull)
  createdBy     Membership                @relation("ExamCreator", fields: [createdById], references: [id], onDelete: Restrict)
  subjects      ExamSubject[]
  enrollments   ExamEnrollment[]
  marks         ExamMark[]
  results       ExamResult[]
  snapshots     ExamResultSnapshot[]
  revisionEvents ExamMarksRevisionEvent[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@index([academicYearId])
  @@index([classId, sectionId])
  @@index([batchId])
  @@index([gradeScaleId])
  @@index([syllabusTrackId])
}

model ExamSubject {
  id           String    @id @default(cuid())
  tenantId     String
  examId       String
  subjectId    String
  examDate     DateTime
  startTime    String?
  endTime      String?
  roomNo       String?
  maxMarks     Float     @default(100)
  passingMarks Float     @default(35)
  weightage    Float     @default(1.0)
  order        Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant         Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  exam           Examination              @relation(fields: [examId], references: [id], onDelete: Cascade)
  subject        Subject                  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  marks          ExamMark[]
  revisionEvents ExamMarksRevisionEvent[]

  @@unique([examId, subjectId])
  @@index([tenantId, examDate])
}

model ExamEnrollment {
  id         String               @id @default(cuid())
  tenantId   String
  examId     String
  studentId      String
  rollNumber     String?
  status         ExamEnrollmentStatus @default(ELIGIBLE)
  remarks        String?
  preservedMarks Json?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  tenant  Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  exam    Examination @relation(fields: [examId], references: [id], onDelete: Cascade)
  student Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  marks   ExamMark[]
  result  ExamResult?

  @@unique([examId, studentId])
  @@index([tenantId, status])
  @@index([studentId])
}

model ExamMark {
  id               String               @id @default(cuid())
  tenantId         String
  examId           String
  examSubjectId    String
  studentId        String
  enrollmentId     String
  marksObtained    Float?
  isAbsent         Boolean              @default(false)
  isExempted       Boolean              @default(false)
  evaluationStatus ExamEvaluationStatus @default(PENDING)
  version          Int                  @default(1)
  feedback         String?
  enteredById      String?
  enteredAt        DateTime?
  verifiedById     String?
  verifiedAt       DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  tenant         Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  exam           Examination              @relation(fields: [examId], references: [id], onDelete: Cascade)
  examSubject    ExamSubject              @relation(fields: [examSubjectId], references: [id], onDelete: Cascade)
  student        Student                  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  enrollment     ExamEnrollment           @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  enteredBy      Membership?              @relation("MarkEnteredBy", fields: [enteredById], references: [id], onDelete: SetNull)
  verifiedBy     Membership?              @relation("MarkVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  revisionEvents ExamMarksRevisionEvent[]

  @@unique([examSubjectId, studentId])
  @@index([examId, studentId])
  @@index([tenantId, evaluationStatus])
}

model ExamResult {
  id                  String           @id @default(cuid())
  tenantId            String
  examId              String
  studentId           String
  enrollmentId        String           @unique
  totalMaxMarks       Float
  totalMarksObtained  Float
  percentage          Float
  grade               String?
  gradePoint          Float?
  rank                Int?
  processingStatus    ExamResultState  @default(DRAFT)
  resultStatus        ExamResultStatus @default(PASS)
  passedSubjectsCount Int              @default(0)
  failedSubjectsCount Int              @default(0)
  remarks             String?
  publishedAt         DateTime?
  publishedById       String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  exam        Examination          @relation(fields: [examId], references: [id], onDelete: Cascade)
  student     Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  enrollment  ExamEnrollment       @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  publishedBy Membership?          @relation("ResultPublisher", fields: [publishedById], references: [id], onDelete: SetNull)
  snapshots   ExamResultSnapshot[]

  @@unique([examId, studentId])
  @@index([examId, rank])
  @@index([tenantId, resultStatus])
}

model ExamResultSnapshot {
  id           String   @id @default(cuid())
  tenantId     String
  examId       String
  studentId    String
  resultId     String
  version      Int      @default(1)
  snapshotData Json
  checksum     String
  generatedAt  DateTime @default(now())

  tenant  Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  exam    Examination @relation(fields: [examId], references: [id], onDelete: Cascade)
  student Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  result  ExamResult  @relation(fields: [resultId], references: [id], onDelete: Cascade)

  @@unique([resultId, version])
  @@index([examId, studentId])
}

model ExamMarksRevisionEvent {
  id            String                @id @default(cuid())
  tenantId      String
  examId        String
  examSubjectId String
  studentId     String
  markId        String
  actorId       String?
  actorName     String
  oldMarks      Float?
  newMarks      Float?
  oldStatus     ExamEvaluationStatus?
  newStatus     ExamEvaluationStatus
  reason        String
  createdAt     DateTime              @default(now())

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  exam        Examination @relation(fields: [examId], references: [id], onDelete: Cascade)
  examSubject ExamSubject @relation(fields: [examSubjectId], references: [id], onDelete: Cascade)
  mark        ExamMark    @relation(fields: [markId], references: [id], onDelete: Cascade)

  @@index([markId, createdAt])
  @@index([examId, examSubjectId])
}

enum CopilotMessageRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

enum CopilotMessageStatus {
  SENT
  STREAMING
  COMPLETE
  ERROR
}

model CopilotThread {
  id        String    @id @default(cuid())
  tenantId  String
  userId    String
  title     String    @default("New Chat")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages CopilotMessage[]

  @@index([tenantId, userId, deletedAt])
  @@index([updatedAt])
}

model CopilotMessage {
  id           String               @id @default(cuid())
  threadId     String
  role         CopilotMessageRole   @default(USER)
  content      String               @db.Text
  status       CopilotMessageStatus @default(COMPLETE)
  provider     String?
  model        String?
  inputTokens  Int?
  outputTokens Int?
  durationMs   Int?
  metadata     Json?
  createdAt    DateTime             @default(now())

  thread CopilotThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
}

// ─────────────────────────────── Student Fee Installment Management ───────────────────────────────

model StudentFeePlan {
  id              String                  @id @default(cuid())
  tenantId        String
  branchId        String?
  studentId       String
  academicYearId  String?
  title           String                  // e.g. "Annual Tuition Plan 2026-27"
  totalAmount     Int                     // Gross fee in paise
  discountAmount  Int                     @default(0) // Concession / scholarship in paise
  payableAmount   Int                     // Net agreed payable in paise
  scheduleType    String                  @default("CUSTOM") // MONTHLY, QUARTERLY, CUSTOM, MANUAL
  status          String                  @default("ACTIVE") // ACTIVE, COMPLETED, CANCELLED
  notes           String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  tenant          Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch          Branch?                 @relation(fields: [branchId], references: [id], onDelete: SetNull)
  student         Student                 @relation(fields: [tenantId, studentId], references: [tenantId, id], onDelete: Cascade)
  installments    StudentFeeInstallment[]

  @@unique([tenantId, id])
  @@index([tenantId, studentId])
  @@index([tenantId, branchId])
  @@index([tenantId, status])
}

model StudentFeeInstallment {
  id                String                      @id @default(cuid())
  tenantId          String
  branchId          String?
  studentId         String
  planId            String
  feeInvoiceId      String?                     // Direct foreign key to authoritative FeeInvoice
  installmentNumber Int                         // 1, 2, 3...
  title             String                      // e.g. "Admission Fee", "Term 1"
  dueDate           DateTime
  originalAmount    Int                         // in paise
  discountAmount    Int                         @default(0) // in paise
  lateFeeAmount     Int                         @default(0) // in paise
  allowPartial      Boolean                     @default(true)
  status            String                      @default("UPCOMING") // UPCOMING, DUE, PARTIALLY_PAID, PAID, OVERDUE, CANCELLED
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt

  tenant            Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch            Branch?                     @relation(fields: [branchId], references: [id], onDelete: SetNull)
  student           Student                     @relation(fields: [tenantId, studentId], references: [tenantId, id], onDelete: Cascade)
  plan              StudentFeePlan              @relation(fields: [planId], references: [id], onDelete: Cascade)
  feeInvoice        FeeInvoice?                 @relation(fields: [feeInvoiceId], references: [id], onDelete: SetNull)
  scheduleChanges   InstallmentScheduleChange[]

  @@unique([tenantId, id])
  @@unique([planId, installmentNumber])
  @@index([tenantId, studentId])
  @@index([tenantId, dueDate])
  @@index([tenantId, status])
  @@index([tenantId, branchId])
  @@index([feeInvoiceId])
}

model InstallmentScheduleChange {
  id            String                @id @default(cuid())
  tenantId      String
  installmentId String
  changedById   String?
  changeType    String                // DUE_DATE_CHANGE, AMOUNT_ADJUSTMENT, STATUS_CHANGE, CANCELLATION
  previousValues Json
  newValues     Json
  reason        String?
  createdAt     DateTime              @default(now())

  installment   StudentFeeInstallment @relation(fields: [installmentId], references: [id], onDelete: Cascade)

  @@index([tenantId, installmentId])
}

model PaymentProviderConfig {
  id            String   @id @default(cuid())
  tenantId      String
  branchId      String?
  provider      String   // DEMO, JODO
  environment   String   @default("DEMO") // DEMO, TEST, LIVE
  merchantId    String?
  collectorCode String?
  isEnabled     Boolean  @default(true)
  secretRef     String?  // Secure credential vault or environment reference
  metadata      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch        Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@unique([tenantId, branchId, provider, environment])
  @@index([tenantId, provider])
  @@index([tenantId, branchId])
}

model PaymentCollectorRoute {
  id                   String   @id @default(cuid())
  tenantId             String
  branchId             String
  provider             String   // DEMO, JODO, RAZORPAY
  merchantId           String?
  environment          String   @default("DEMO") // DEMO, TEST, LIVE
  collectorCode        String
  routingDiscriminator String?  // Optional provider-supported routing discriminator (e.g. sub-merchant, custom tag)
  isActive             Boolean  @default(true)
  metadata             Json?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  tenant               Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch               Branch   @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  // NOTE: Route uniqueness invariants are intentionally managed via PostgreSQL-native indexes in SQL migrations:
  // 1. "uq_pcr_branch_route_identity": Unique on (tenantId, branchId, provider, environment, collectorCode, merchantId, routingDiscriminator) NULLS NOT DISTINCT
  // 2. "uq_pcr_explicit_discriminator": Partial unique on (tenantId, provider, environment, collectorCode, merchantId, routingDiscriminator) NULLS NOT DISTINCT WHERE routingDiscriminator IS NOT NULL
  // These invariants use PostgreSQL 15+ NULLS NOT DISTINCT semantics not expressible in Prisma's standard @@unique syntax.
  @@index([tenantId, provider, environment])
  @@index([tenantId, collectorCode])
  @@index([tenantId, merchantId])
  @@index([tenantId, branchId])
}

// ─────────────────────────────── Dedicated Demo Payment Models (Isolated) ───────────────────────────────

model DemoFeePlan {
  id             String               @id @default(cuid())
  tenantId       String
  branchId       String?
  studentId      String
  title          String
  totalAmount    Int
  discountAmount Int                  @default(0)
  payableAmount  Int
  scheduleType   String               @default("CUSTOM")
  status         String               @default("ACTIVE")
  notes          String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  tenant         Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch         Branch?              @relation(fields: [branchId], references: [id], onDelete: SetNull)
  student        Student              @relation(fields: [tenantId, studentId], references: [tenantId, id], onDelete: Cascade)
  installments   DemoFeeInstallment[]

  @@unique([tenantId, id])
  @@index([tenantId, studentId])
  @@index([tenantId, branchId])
}

model DemoFeeInstallment {
  id                String                   @id @default(cuid())
  tenantId          String
  branchId          String?
  studentId         String
  demoPlanId        String
  installmentNumber Int
  title             String
  dueDate           DateTime
  originalAmount    Int
  paidAmount        Int                      @default(0)
  allowPartial      Boolean                  @default(true)
  status            String                   @default("UPCOMING")
  sourceInstallmentId String?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  tenant            Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch            Branch?                  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  student           Student                  @relation(fields: [tenantId, studentId], references: [tenantId, id], onDelete: Cascade)
  demoPlan          DemoFeePlan              @relation(fields: [demoPlanId], references: [id], onDelete: Cascade)
  transactions      DemoPaymentTransaction[]

  @@unique([tenantId, id])
  @@unique([demoPlanId, installmentNumber])
  @@index([tenantId, studentId])
  @@index([tenantId, dueDate])
  @@index([tenantId, status])
  @@index([sourceInstallmentId])
}

model DemoPaymentSession {
  id                  String                   @id @default(cuid())
  tenantId            String
  branchId            String?
  studentId           String
  sessionToken        String                   @unique
  tokenHash           String?                  @unique
  sourceInstallmentId String?
  amount              Int                      // in paise
  currency            String                   @default("INR")
  status              String                   @default("OPEN") // OPEN, SUCCESS, FAILED, PENDING, CANCELLED, EXPIRED
  installmentIds      Json                     // Array of demo installment IDs
  allowPartial        Boolean                  @default(true)
  expiresAt           DateTime
  completedAt         DateTime?
  payerName           String?
  payerPhone          String?
  metadata            Json?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  tenant         Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch         Branch?                  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  student        Student                  @relation(fields: [tenantId, studentId], references: [tenantId, id], onDelete: Cascade)
  transactions   DemoPaymentTransaction[]

  @@index([tenantId, sessionToken])
  @@index([tenantId, tokenHash])
  @@index([tenantId, studentId])
  @@index([tenantId, status])
}

model DemoPaymentTransaction {
  id                String             @id @default(cuid())
  tenantId          String
  sessionId         String
  demoInstallmentId String
  amount            Int                // in paise
  status            String             // SUCCESS, FAILED, PENDING, CANCELLED, EXPIRED
  provider          String             @default("DEMO")
  reference         String             // e.g. DEMO-TX-XXXX
  simulationOutcome String             // SUCCESS, FAILED, PENDING, CANCELLED, EXPIRED
  createdAt         DateTime           @default(now())

  session           DemoPaymentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  demoInstallment   DemoFeeInstallment @relation(fields: [demoInstallmentId], references: [id], onDelete: Cascade)

  @@index([tenantId, sessionId])
  @@index([demoInstallmentId])
}
